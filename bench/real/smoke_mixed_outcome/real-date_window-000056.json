            "extracted_code": "\"\"\"Date-window membership for the date_window fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime\n\n\ndef _parse_date(date_str: str) -> datetime.date:\n    \"\"\"Parse a strict ISO date string, raising ValueError for malformed input.\"\"\"\n    if not isinstance(date_str, str):\n        raise ValueError(f\"Expected a string, got {type(date_str)}\")\n    # datetime.date.fromisoformat in Python 3.7+ accepts YYYY-MM-DD\n    # but we also need to reject missing zero-padding\n    # fromisoformat is strict about format in 3.7+\n    try:\n        parsed = datetime.date.fromisoformat(date_str)\n    except ValueError:\n        raise ValueError(f\"Malformed date: {date_str!r}\")\n    # Ensure the string round-trips exactly (catches things like fromisoformat\n    # being lenient in some Python versions)\n    if parsed.isoformat() != date_str:\n        raise ValueError(f\"Malformed date: {date_str!r}\")\n    return parsed\n\n\ndef in_any_window(target_date: str, windows: list[tuple[str, str]]) -> bool:\n    \"\"\"Return whether target_date falls inside any date window.\"\"\"\n    target = _parse_date(target_date)\n\n    for start_str, end_str in windows:\n        start = _parse_date(start_str)\n        end = _parse_date(end_str)\n\n        if start > end:\n            raise ValueError(\n                f\"Window start {start_str!r} is after end {end_str!r}\"\n            )\n\n        if start <= target <= end:\n            return True\n\n    return False\n"
