            "extracted_code": "\"\"\"Date-window membership for the date_window fixture.\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime\n\n\ndef _parse_date(date_str: str) -> datetime.date:\n    \"\"\"Parse a strict ISO date string, raising ValueError if malformed.\"\"\"\n    if not isinstance(date_str, str):\n        raise ValueError(f\"Expected string, got {type(date_str)}\")\n    # Validate format strictly: must be YYYY-MM-DD with zero-padding\n    parts = date_str.split(\"-\")\n    if len(parts) != 3:\n        raise ValueError(f\"Invalid date format: {date_str!r}\")\n    year_str, month_str, day_str = parts\n    if len(year_str) != 4 or len(month_str) != 2 or len(day_str) != 2:\n        raise ValueError(f\"Invalid date format (wrong field widths): {date_str!r}\")\n    if not (year_str.isdigit() and month_str.isdigit() and day_str.isdigit()):\n        raise ValueError(f\"Invalid date format (non-numeric): {date_str!r}\")\n    try:\n        return datetime.date(int(year_str), int(month_str), int(day_str))\n    except ValueError as exc:\n        raise ValueError(f\"Invalid calendar date: {date_str!r}\") from exc\n\n\ndef in_any_window(target_date: str, windows: list[tuple[str, str]]) -> bool:\n    \"\"\"Return whether target_date falls inside any date window.\"\"\"\n    target = _parse_date(target_date)\n\n    for start_str, end_str in windows:\n        start = _parse_date(start_str)\n        end = _parse_date(end_str)\n        if start > end:\n            raise ValueError(\n                f\"Window start {start_str!r} is after end {end_str!r}\"\n            )\n        if start <= target <= end:\n            return True\n\n    return False\n"
          },
