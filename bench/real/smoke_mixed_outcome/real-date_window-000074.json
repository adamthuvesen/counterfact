            "extracted_code": "\"\"\"Date-window membership for the date_window fixture.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\n\n\ndef _parse_and_validate_date(date_str: str) -> datetime:\n    \"\"\"Parse and validate a date string in YYYY-MM-DD format.\n    \n    Raises ValueError if the date is malformed or invalid.\n    \"\"\"\n    try:\n        return datetime.strptime(date_str, \"%Y-%m-%d\")\n    except ValueError:\n        raise ValueError(f\"Invalid date format or impossible calendar date: {date_str}\")\n\n\ndef in_any_window(target_date: str, windows: list[tuple[str, str]]) -> bool:\n    \"\"\"Return whether target_date falls inside any date window.\n    \n    All dates must be in strict ISO calendar-date form (YYYY-MM-DD).\n    Window boundaries are inclusive on both ends.\n    Raises ValueError for malformed dates or invalid windows (start > end).\n    \"\"\"\n    # Parse and validate the target date\n    target = _parse_and_validate_date(target_date)\n    \n    # Check each window\n    for start_str, end_str in windows:\n        # Parse and validate window boundaries\n        start = _parse_and_validate_date(start_str)\n        end = _parse_and_validate_date(end_str)\n        \n        # Check if start > end\n        if start > end:\n            raise ValueError(f\"Invalid window: start ({start_str}) > end ({end_str})\")\n        \n        # Check if target is within this window (inclusive on both ends)\n        if start <= target <= end:\n            return True\n    \n    return False\n"
