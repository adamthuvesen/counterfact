            "extracted_code": "\"\"\"Date-window membership for the date_window fixture.\"\"\"\n\nfrom __future__ import annotations\nfrom datetime import datetime\n\n\ndef _is_valid_date(date_str: str) -> bool:\n    \"\"\"Check if a date string is valid ISO format YYYY-MM-DD.\"\"\"\n    try:\n        datetime.strptime(date_str, \"%Y-%m-%d\")\n        return True\n    except ValueError:\n        return False\n\n\ndef in_any_window(target_date: str, windows: list[tuple[str, str]]) -> bool:\n    \"\"\"Return whether target_date falls inside any date window.\n    \n    All dates must be in strict ISO calendar-date form: YYYY-MM-DD.\n    Window boundaries are inclusive.\n    Validates all dates and window constraints before checking membership.\n    \"\"\"\n    # Validate target_date\n    if not _is_valid_date(target_date):\n        raise ValueError(f\"Invalid date format: {target_date}\")\n    \n    target = datetime.strptime(target_date, \"%Y-%m-%d\")\n    \n    # Validate all windows and check constraints\n    for start_str, end_str in windows:\n        if not _is_valid_date(start_str):\n            raise ValueError(f\"Invalid date format: {start_str}\")\n        if not _is_valid_date(end_str):\n            raise ValueError(f\"Invalid date format: {end_str}\")\n        \n        start = datetime.strptime(start_str, \"%Y-%m-%d\")\n        end = datetime.strptime(end_str, \"%Y-%m-%d\")\n        \n        if start > end:\n            raise ValueError(f\"Invalid window: start ({start_str}) > end ({end_str})\")\n    \n    # Check if target falls in any window\n    for start_str, end_str in windows:\n        start = datetime.strptime(start_str, \"%Y-%m-%d\")\n        end = datetime.strptime(end_str, \"%Y-%m-%d\")\n        \n        if start <= target <= end:\n            return True\n    \n    return False\n"
